# Experimental prerequisites only; not applied to released firmware defaults.
# The VMM must provide ACPI discovery and a virtio-mem device before hot-add works.
CONFIG_ACPI=y
CONFIG_ACPI_REDUCED_HARDWARE_ONLY=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_HOTPLUG_CPU=y
CONFIG_ACPI_HOTPLUG_CPU=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_VIRTIO_MEM=y
