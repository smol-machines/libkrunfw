 	return kstrtobool(buf, &evtstrm_enable);
@@ -111,21 +216,21 @@ static noinstr u64 arch_counter_get_cntpct(void)
 
 static noinstr u64 raw_counter_get_cntvct_stable(void)
 {
-	return __arch_counter_get_cntvct_stable();
+	return arch_timer_rebased_read(__arch_counter_get_cntvct_stable());
 }
 
 static notrace u64 arch_counter_get_cntvct_stable(void)
 {
 	u64 val;
 	preempt_disable_notrace();
-	val = __arch_counter_get_cntvct_stable();
+	val = arch_timer_rebased_read(__arch_counter_get_cntvct_stable());
 	preempt_enable_notrace();
 	return val;
 }
 
 static noinstr u64 arch_counter_get_cntvct(void)
 {
-	return __arch_counter_get_cntvct();
+	return arch_timer_rebased_read(__arch_counter_get_cntvct());
 }
 
 /*
@@ -159,6 +264,52 @@ static struct cyclecounter cyclecounter __ro_after_init = {
 	.read	= arch_counter_read_cc,
 };
 
+/* Runs with the timekeeper locked; see timekeeping_rebase_clocksource(). */
+static void arch_timer_rebase_counter(void *arg)
+{
+	struct arch_timer_rebase_data rb;
+	u32 rate = *(u32 *)arg;
+	u64 hw = __arch_counter_get_cntvct();
+
+	/* Continue from where the current mapping is now. */
+	rb.hw_base = hw;
+	rb.virt_base = arch_timer_rebased ?
+		arch_timer_rebase_map(&arch_timer_rebase.data[0], hw) : hw;
+	rb.mult = mul_u64_u64_div_u64(arch_timer_rate,
+				      1ULL << ARCH_TIMER_REBASE_SHIFT, rate);
+	rb.inv_mult = mul_u64_u64_div_u64(rate, 1ULL << ARCH_TIMER_REBASE_SHIFT,
+					  arch_timer_rate);
+
+	arch_timer_rebase.data[1] = rb;
+	raw_write_seqcount_latch(&arch_timer_rebase.seq);
+	arch_timer_rebase.data[0] = rb;
+	raw_write_seqcount_latch(&arch_timer_rebase.seq);
+	smp_store_release(&arch_timer_rebased, true);
+	WRITE_ONCE(arch_timer_cur_rate, rate);
+
+	/*
+	 * The vDSO reads the hardware counter directly and cannot apply the
+	 * mapping, so user space falls back to the clock_gettime() syscall.
+	 */
+	clocksource_counter.vdso_clock_mode = VDSO_CLOCKMODE_NONE;
+}
+
+static noinline void arch_timer_rate_changed(u32 rate)
+{
+	bool changed = false;
+
+	raw_spin_lock(&arch_timer_rebase_lock);
+	if (rate != arch_timer_cur_rate) {
+		timekeeping_rebase_clocksource(arch_timer_rebase_counter, &rate);
+		changed = true;
+	}
+	raw_spin_unlock(&arch_timer_rebase_lock);
+
+	if (changed)
+		pr_info("counter now runs at %u Hz (booted at %u Hz), keeping time in boot-rate ticks\n",
+			rate, arch_timer_rate);
+}
+
 struct ate_acpi_oem_info {
 	char oem_id[ACPI_OEM_ID_SIZE + 1];
 	char oem_table_id[ACPI_OEM_TABLE_ID_SIZE + 1];
@@ -577,10 +728,36 @@ static __always_inline irqreturn_t timer_handler(const int access,
 	return IRQ_NONE;
 }
 
+static void arch_timer_configure_evtstream(void);
+
+/*
+ * Notice that the counter now runs at another rate (the VM was restored on a
+ * different host) before anything converts counter ticks to time.
+ */
+static __always_inline void arch_timer_follow_rate(void)
+{
+	u32 cur = READ_ONCE(arch_timer_cur_rate);
+	u32 rate;
+
+	if (!cur)
+		return;
+
+	rate = arch_timer_get_cntfrq();
+	if (unlikely(rate && rate != cur)) {
+		arch_timer_rate_changed(rate);
+		cur = READ_ONCE(arch_timer_cur_rate);
+	}
+
+	if (unlikely(__this_cpu_read(arch_timer_evtstrm_rate) != cur) &&
+	    cpumask_test_cpu(smp_processor_id(), &evtstrm_available))
+		arch_timer_configure_evtstream();
+}
+
 static irqreturn_t arch_timer_handler_virt(int irq, void *dev_id)
 {
 	struct clock_event_device *evt = dev_id;
 
+	arch_timer_follow_rate();
 	return timer_handler(ARCH_TIMER_VIRT_ACCESS, evt);
 }
 
@@ -623,10 +800,12 @@ static __always_inline void set_next_event(const int access, unsigned long evt,
 	ctrl |= ARCH_TIMER_CTRL_ENABLE;
 	ctrl &= ~ARCH_TIMER_CTRL_IT_MASK;
 
-	if (access == ARCH_TIMER_PHYS_ACCESS)
+	if (access == ARCH_TIMER_PHYS_ACCESS) {
 		cnt = __arch_counter_get_cntpct();
-	else
+	} else {
 		cnt = __arch_counter_get_cntvct();
+		evt = arch_timer_hw_cycles(evt);
+	}
 
 	arch_timer_reg_write_cp15(access, ARCH_TIMER_REG_CVAL, evt + cnt);
 	arch_timer_reg_write_cp15(access, ARCH_TIMER_REG_CTRL, ctrl);
@@ -735,13 +914,16 @@ static void arch_timer_evtstrm_enable(unsigned int divider)
 
 static void arch_timer_configure_evtstream(void)
 {
+	u32 rate = READ_ONCE(arch_timer_cur_rate) ?: arch_timer_rate;
 	int evt_stream_div, lsb;
 
+	__this_cpu_write(arch_timer_evtstrm_rate, rate);
+
 	/*
 	 * As the event stream can at most be generated at half the frequency
 	 * of the counter, use half the frequency when computing the divider.
 	 */
-	evt_stream_div = arch_timer_rate / ARCH_TIMER_EVT_STREAM_FREQ / 2;
+	evt_stream_div = rate / ARCH_TIMER_EVT_STREAM_FREQ / 2;
 
 	/*
 	 * Find the closest power of two to the divisor. If the adjacent bit
@@ -947,6 +1129,12 @@ static void __init arch_counter_register(void)
 			 &cyclecounter, start_count);
 
 	sched_clock_register(scr, width, arch_timer_rate);
+
+	/* 6.18 dropped the MMIO counter: this is always the CP15 counter. */
+	if (arch_timer_uses_ppi == ARCH_TIMER_VIRT_PPI &&
+	    !arch_timer_counter_has_wa() &&
+	    arch_timer_get_cntfrq() == arch_timer_rate)
+		WRITE_ONCE(arch_timer_cur_rate, arch_timer_rate);
 }
 
