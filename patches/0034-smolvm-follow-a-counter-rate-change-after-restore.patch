+++ b/arch/arm64/lib/delay.c
@@ -42,6 +42,9 @@ void __delay(unsigned long cycles)
 {
 	cycles_t start = __delay_cycles();
 
+	/* @cycles are boot-rate ticks; the loops below poll the hardware counter. */
+	cycles = arch_timer_hw_cycles(cycles);
+
 	if (alternative_has_cap_unlikely(ARM64_HAS_WFXT)) {
 		u64 end = start + cycles;
 
diff --git a/drivers/clocksource/arm_arch_timer.c b/drivers/clocksource/arm_arch_timer.c
index 90aeff44a..4d3458a76 100644
--- a/drivers/clocksource/arm_arch_timer.c
+++ b/drivers/clocksource/arm_arch_timer.c
@@ -28,6 +28,9 @@
 #include <linux/acpi.h>
 #include <linux/arm-smccc.h>
 #include <linux/ptp_kvm.h>
+#include <linux/math64.h>
+#include <linux/seqlock.h>
+#include <linux/timekeeping.h>
 
 #include <asm/arch_timer.h>
 #include <asm/virt.h>
@@ -65,6 +68,108 @@ static enum vdso_clock_mode vdso_default = VDSO_CLOCKMODE_NONE;
 static cpumask_t evtstrm_available = CPU_MASK_NONE;
 static bool evtstrm_enable __ro_after_init = IS_ENABLED(CONFIG_ARM_ARCH_TIMER_EVTSTREAM);
 
+/*
+ * A virtual machine can be checkpointed on one host and restored on another
+ * whose system counter runs at a different rate, e.g. 24 MHz on Apple silicon
+ * and 1 GHz on Armv8.6+ servers. Everything above this driver converts
+ * counter ticks to time with the rate it saw at boot, so after such a move
+ * the virtual counter is read through a mapping back into boot-rate ticks:
+ *
+ *	ticks = virt_base + (hw - hw_base) * mult >> ARCH_TIMER_REBASE_SHIFT
+ *
+ * The mapping is the identity until the counter rate first changes, which
+ * the timer interrupt notices by re-reading CNTFRQ_EL0. Event deadlines are
+ * converted the other way with inv_mult. The two copies are a seqcount
+ * latch so NMI-safe and noinstr readers never see a torn mapping.
+ */
+#define ARCH_TIMER_REBASE_SHIFT	48
+
+struct arch_timer_rebase_data {
+	u64	hw_base;
+	u64	virt_base;
+	u64	mult;		/* boot rate / current rate */
+	u64	inv_mult;	/* current rate / boot rate */
+};
+
+static struct {
+	seqcount_latch_t		seq;
+	struct arch_timer_rebase_data	data[2];
+} arch_timer_rebase ____cacheline_aligned = {
+	.seq = SEQCNT_LATCH_ZERO(arch_timer_rebase.seq),
+};
+
+/* Set once the counter has run at a rate other than the boot rate. */
+static bool arch_timer_rebased;
+/* Rate the counter runs at now; 0 when rate changes are not followed. */
+static u32 arch_timer_cur_rate;
+/* Rate each CPU's event stream divider was computed for. */
+static DEFINE_PER_CPU(u32, arch_timer_evtstrm_rate);
+static DEFINE_RAW_SPINLOCK(arch_timer_rebase_lock);
+
+/*
+ * Read-only marker: user space (the smolvm guest agent) checks for it before
+ * allowing a checkpoint of this guest to move to a host whose counter runs at
+ * another rate.
+ */
+static bool arch_timer_follows_counter_rate = true;
+module_param_named(follows_counter_rate, arch_timer_follows_counter_rate, bool, 0444);
+
+static __always_inline u64
+arch_timer_rebase_map(const struct arch_timer_rebase_data *rb, u64 hw)
+{
+	return rb->virt_base +
+	       mul_u64_u64_shr(hw - rb->hw_base, rb->mult, ARCH_TIMER_REBASE_SHIFT);
+}
+
+/*
+ * Read the counter with @read_hw and map it to boot-rate ticks. The hardware
+ * read happens inside the latch section, after the mapping was published, so
+ * it is never older than the mapping's hw_base.
+ */
+#define arch_timer_rebased_read(read_hw)				\
+({									\
+	u64 __ticks;							\
+									\
+	if (likely(!smp_load_acquire(&arch_timer_rebased))) {		\
+		__ticks = (read_hw);					\
+	} else {							\
+		unsigned int __seq;					\
+									\
+		do {							\
+			__seq = raw_read_seqcount_latch(&arch_timer_rebase.seq); \
+			__ticks = arch_timer_rebase_map(		\
+				&arch_timer_rebase.data[__seq & 1], (read_hw)); \
+		} while (raw_read_seqcount_latch_retry(&arch_timer_rebase.seq, __seq)); \
+	}								\
+	__ticks;							\
+})
+
+/**
+ * arch_timer_hw_cycles - convert boot-rate ticks to hardware counter ticks
+ * @ticks: an interval in ticks of the rate the kernel booted with
+ *
+ * For code that programs or polls the hardware counter directly, such as
+ * timer deadlines and the delay loop. The identity until the counter rate
+ * changes.
+ */
+u64 notrace arch_timer_hw_cycles(u64 ticks)
+{
+	unsigned int seq;
+	u64 hw;
+
+	if (likely(!smp_load_acquire(&arch_timer_rebased)))
+		return ticks;
+
+	do {
+		seq = raw_read_seqcount_latch(&arch_timer_rebase.seq);
+		hw = mul_u64_u64_shr(ticks, arch_timer_rebase.data[seq & 1].inv_mult,
+				     ARCH_TIMER_REBASE_SHIFT);
+	} while (raw_read_seqcount_latch_retry(&arch_timer_rebase.seq, seq));
+
+	return hw;
+}
+EXPORT_SYMBOL_GPL(arch_timer_hw_cycles);
