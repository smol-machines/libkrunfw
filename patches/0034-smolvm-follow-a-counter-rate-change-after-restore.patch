+/**
+ * timekeeping_rebase_clocksource - change how the current clocksource reads
+ * @rebase:	callback that switches the clocksource's read mapping
+ * @arg:	argument for @rebase
+ *
+ * For a clocksource whose underlying counter changed rate underneath the
+ * kernel, e.g. a virtual machine restored on a host with a different system
+ * counter frequency. @rebase runs with the timekeeper locked and must keep
+ * the clocksource's reads continuous: a read right after the switch may not
+ * be lower than a read right before it. Safe to call from hard interrupt
+ * context.
+ */
+void timekeeping_rebase_clocksource(void (*rebase)(void *), void *arg)
+{
+	scoped_guard (raw_spinlock_irqsave, &tk_core.lock) {
+		struct timekeeper *tks = &tk_core.shadow_timekeeper;
+
+		timekeeping_forward_now(tks);
+		rebase(arg);
+		timekeeping_update_from_shadow(&tk_core, TK_CLOCK_WAS_SET);
+	}
+}
