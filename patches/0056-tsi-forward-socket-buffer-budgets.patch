 		return -EINVAL;
-	supported = (level == SOL_SOCKET &&
+	buffer = level == SOL_SOCKET &&
+		 (optname == SO_SNDBUF || optname == SO_RCVBUF ||
+		  optname == SO_SNDBUFFORCE || optname == SO_RCVBUFFORCE);
+	supported = buffer || (level == SOL_SOCKET &&
 		     (optname == SO_REUSEADDR || optname == SO_REUSEPORT ||
 		      optname == SO_BROADCAST || optname == SO_KEEPALIVE)) ||
 		    (level == IPPROTO_TCP &&
@@ -1875,6 +1941,13 @@
 	}
 	*applied = value;
 	wire_value = value;
+	if (buffer) {
