+		if (err)
+			return err;
+		wire_option = (optname == SO_RCVBUF || optname == SO_RCVBUFFORCE) ?
+			      SO_RCVBUF : SO_SNDBUF;
+	}
 	if (level == IPPROTO_IP) {
 		if (value < -1 || value == 0 || value > 255)
 			return -EINVAL;
@@ -1894,7 +1967,7 @@
 	req.svm_port = cpu_to_le32(tsk->svm_port);
 	req.svm_peer_port = cpu_to_le32(tsk->svm_peer_port);
 	req.level = cpu_to_le32(level);
-	req.option = cpu_to_le32(optname);
+	req.option = cpu_to_le32(wire_option);
 	req.value = cpu_to_le32(wire_value);
 	err = tsi_control_sendmsg(tsk->csocket, TSI_HOST_SETSOCKOPT,
 				  &req, sizeof(req));
@@ -1908,7 +1981,12 @@
 		return err;
 	if (err != sizeof(rsp))
 		return -EPROTO;
-	return le32_to_cpu(rsp.result);
+	err = le32_to_cpu(rsp.result);
+	if (!err && buffer) {
+		tsi_host_buffer_commit(tsk, optname, wire_value);
+		return 2;
+	}
+	return err;
 }
 
