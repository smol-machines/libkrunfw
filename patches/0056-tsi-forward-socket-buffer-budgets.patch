 		return err;
 	dst = child->isocket->sk;
+	dst->sk_userlocks = src->sk_userlocks;
 	for (i = 0; i < ARRAY_SIZE(options); i++) {
 		tsi_mirror_sol_socket_field(dst, src, options[i]);
 		tsi_mirror_sol_socket_field(sk_tsi(child), src, options[i]);
@@ -1821,22 +1822,87 @@
