 }
 
+/* Use Linux's validation, privilege checks and buffer canonicalization on
+ * the private inet socket, then restore its state until the host accepts it.
+ * The outer socket lock serializes every access to this private option state.
+ */
+static int tsi_host_buffer_value(struct tsi_sock *tsk, int optname, int value,
+				 int *capacity)
+{
+	struct sock *sk = tsk->isocket->sk;
+	bool receive = optname == SO_RCVBUF || optname == SO_RCVBUFFORCE;
+	int previous = receive ? READ_ONCE(sk->sk_rcvbuf) : READ_ONCE(sk->sk_sndbuf);
+	unsigned int locks = sk->sk_userlocks;
+	int err;
+
+	err = sock_setsockopt(tsk->isocket, SOL_SOCKET, optname,
+			      KERNEL_SOCKPTR(&value), sizeof(value));
+	if (err)
+		return err;
+	*capacity = receive ? READ_ONCE(sk->sk_rcvbuf) : READ_ONCE(sk->sk_sndbuf);
+	if (receive)
+		WRITE_ONCE(sk->sk_rcvbuf, previous);
+	else
+		WRITE_ONCE(sk->sk_sndbuf, previous);
+	sk->sk_userlocks = locks;
+	return 0;
+}
+
+static void tsi_host_buffer_commit(struct tsi_sock *tsk, int optname, int capacity)
+{
+	struct sock *sk = tsk->isocket->sk;
+	struct sock *vsk = tsk->vsocket->sk;
+	struct vsock_sock *vs = vsock_sk(vsk);
+	bool receive = optname == SO_RCVBUF || optname == SO_RCVBUFFORCE;
+
+	if (receive) {
+		WRITE_ONCE(sk->sk_rcvbuf, capacity);
+		sk->sk_userlocks |= SOCK_RCVBUF_LOCK;
+	} else {
+		WRITE_ONCE(sk->sk_sndbuf, capacity);
+		sk->sk_userlocks |= SOCK_SNDBUF_LOCK;
+	}
+	tsi_mirror_sol_socket_field(sk_tsi(tsk), sk, optname);
+	lock_sock(vsk);
+	tsi_mirror_sol_socket_field(vsk, sk, optname);
+	if (receive) {
+		vsk->sk_userlocks |= SOCK_RCVBUF_LOCK;
+		if (sk_tsi(tsk)->sk_type == SOCK_STREAM) {
+			const struct vsock_transport *transport = vs->transport;
+			u64 size = capacity;
+
+			if (transport && transport->notify_buffer_size)
+				transport->notify_buffer_size(vs, &size);
+			vs->buffer_size = size;
+		}
+	} else {
+		vsk->sk_userlocks |= SOCK_SNDBUF_LOCK;
+		WRITE_ONCE(vs->tsi_send_capacity, capacity);
+		vsk->sk_write_space(vsk);
+	}
+	release_sock(vsk);
+}
