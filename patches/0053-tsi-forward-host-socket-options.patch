From: binsquare <hebinsquared@gmail.com>
Subject: [PATCH] tsi: apply host socket options and keep inet queries safe

Forward integer options to the host socket and query Linux state without
calling a missing private vsock handler, requiring host-network ABI 4.

Signed-off-by: binsquare <hebinsquared@gmail.com>
---
--- a/net/tsi/af_tsi.c
+++ b/net/tsi/af_tsi.c
@@ -46,7 +46,7 @@
 };
 
 /* Selected by the VMM only with a matching host socket transport. */
-static const char tsi_host_network_abi[] __used = "KRUN_TSI_HOST_NETWORK_ABI_3";
+static const char tsi_host_network_abi[] __used = "KRUN_TSI_HOST_NETWORK_ABI_4";
 static bool tsi_host_network;
 core_param(tsi_host_network, tsi_host_network, bool, 0);
 
@@ -1786,13 +1786,91 @@
 	}
 }
 
+/* The supported integer options are validated before changing either side.
+ * Return one for guest-only options, zero on remote success, or an errno.
+ */
+static int tsi_host_setsockopt(struct tsi_sock *tsk, int level, int optname,
+			       sockptr_t optval, unsigned int optlen, int *applied)
+{
+	struct tsi_host_sockopt_req req;
+	struct tsi_getname_rsp rsp = { 0 };
+	int value, wire_value, err;
+	bool supported;
+
+	if (!tsi_host_enabled(tsk))
+		return 1;
+	if (level == IPPROTO_IPV6 && optname == IPV6_V6ONLY && tsk->bound_addr)
+		return -EINVAL;
+	supported = (level == SOL_SOCKET &&
+		     (optname == SO_REUSEADDR || optname == SO_REUSEPORT ||
+		      optname == SO_BROADCAST || optname == SO_KEEPALIVE)) ||
+		    (level == IPPROTO_TCP && optname == TCP_NODELAY &&
+		     sk_tsi(tsk)->sk_type == SOCK_STREAM) ||
+		    (level == IPPROTO_IP && optname == IP_TTL) ||
+		    (level == IPPROTO_IPV6 && optname == IPV6_UNICAST_HOPS &&
+		     tsk->family == AF_INET6);
+	if (!supported) {
+		if (level == SOL_SOCKET ||
+		    (level == IPPROTO_IPV6 && optname == IPV6_V6ONLY))
+			return 1;
+		return -ENOPROTOOPT;
+	}
+	if (level == IPPROTO_IP && optlen && optlen < sizeof(value)) {
+		u8 byte;
+
+		if (copy_from_sockptr(&byte, optval, sizeof(byte)))
+			return -EFAULT;
+		value = byte;
+	} else {
+		if (optlen < sizeof(value))
+			return -EINVAL;
+		if (copy_from_sockptr(&value, optval, sizeof(value)))
+			return -EFAULT;
+	}
+	*applied = value;
+	wire_value = value;
+	if (level == IPPROTO_IP) {
+		if (value < -1 || value == 0 || value > 255)
+			return -EINVAL;
+		if (value == -1)
+			wire_value = READ_ONCE(sock_net(sk_tsi(tsk))->ipv4.sysctl_ip_default_ttl);
+	} else if (level == IPPROTO_IPV6) {
+		if (value < -1 || value > 255)
+			return -EINVAL;
+		if (value == -1)
+			wire_value = READ_ONCE(sock_net(sk_tsi(tsk))->ipv6.devconf_all->hop_limit);
+	}
+	if (!tsk->svm_port) {
+		err = tsi_create_proxy(tsk, sk_tsi(tsk)->sk_type);
+		if (err)
+			return err;
+	}
+	req.svm_port = cpu_to_le32(tsk->svm_port);
+	req.level = cpu_to_le32(level);
+	req.option = cpu_to_le32(optname);
+	req.value = cpu_to_le32(wire_value);
+	err = tsi_control_sendmsg(tsk->csocket, TSI_HOST_SETSOCKOPT,
+				  &req, sizeof(req));
+	if (err < 0)
+		return err;
+	if (err != sizeof(req))
+		return -EPROTO;
+	err = tsi_control_recvmsg(tsk->csocket, TSI_HOST_SETSOCKOPT,
+				  &rsp, sizeof(rsp));
+	if (err < 0)
+		return err;
+	if (err != sizeof(rsp))
+		return -EPROTO;
+	return le32_to_cpu(rsp.result);
+}
+
 static int tsi_stream_setsockopt(struct socket *sock, int level, int optname,
 				 sockptr_t optval, unsigned int optlen)
 {
 	struct sock *sk = sock->sk;
 	struct tsi_sock *tsk;
 	struct socket *isocket;
-	int err;
+	int err, applied;
 
 	lock_sock(sk);
 	tsk = tsi_sk(sock->sk);
@@ -1800,6 +1878,25 @@
 
 	pr_debug("%s: s=%p is=%p st=%d family=%d\n", __func__, sock, isocket,
 		 tsk->status, tsk->family);
+
+	err = tsi_host_setsockopt(tsk, level, optname, optval, optlen, &applied);
+	if (err < 0) {
+		release_sock(sk);
+		return err;
+	}
+	if (!err) {
+		/* Reuse the validated copy, never reread a mutable user buffer. */
+		optval = KERNEL_SOCKPTR(&applied);
+		optlen = sizeof(applied);
+	}
+	/* The inet socket retains Linux option validation and query state. */
+	if (tsi_host_enabled(tsk) && level != SOL_SOCKET) {
+		err = isocket->ops->setsockopt ?
+			isocket->ops->setsockopt(isocket, level, optname, optval, optlen) :
+			-ENOPROTOOPT;
+		release_sock(sk);
+		return err;
+	}
 
 	switch (tsk->status) {
 	case S_HYBRID:
@@ -1846,7 +1943,7 @@
 	struct sock *sk = sock->sk;
