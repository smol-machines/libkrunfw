 /* Receive one datagram the proxy delivered, naming the peer it came from. */
+/* Receive complete host UDP datagrams without enlarging virtio RX buffers. */
+struct tsi_host_dgram_frame {
+	__le32 sequence;
+	__le32 total;
+	__le32 offset;
+	__le32 addr_len;
+	u8 addr[28];
+} __packed;
+
+static int tsi_host_dgram_recvmsg(struct tsi_sock *tsk, struct msghdr *msg,
+				  size_t len, int flags)
+{
+	struct tsi_host_dgram_frame frame, received;
+	struct msghdr wire_msg;
+	struct kvec vec[2];
+	u32 total, offset, addr_len, sequence;
+	size_t copied;
+	int err, n;
+	__le16 family;
+
+	if (flags & (MSG_OOB | MSG_ERRQUEUE))
+		return -EOPNOTSUPP;
+	if (flags & MSG_DONTWAIT) {
+		if (!mutex_trylock(&tsk->host_rx_lock))
+			return -EAGAIN;
+	} else if (mutex_lock_interruptible(&tsk->host_rx_lock)) {
+		return -ERESTARTSYS;
+	}
+
+	while (!tsk->host_rx_ready) {
+		/* Peek just the header, then receive into the final payload buffer.
+		 * Only this mutex-protected path consumes this private vsock, so
+		 * nothing can replace the peeked message before the receive below.
+		 */
+		memset(&wire_msg, 0, sizeof(wire_msg));
+		vec[0].iov_base = &frame;
+		vec[0].iov_len = sizeof(frame);
+		WRITE_ONCE(tsk->vsocket->sk->sk_rcvtimeo,
+			   READ_ONCE(tsk->isocket->sk->sk_rcvtimeo));
+		n = kernel_recvmsg(tsk->vsocket, &wire_msg, vec, 1,
+				   sizeof(frame), (flags & MSG_DONTWAIT) | MSG_PEEK);
+		if (n < 0) {
+			err = n;
+			goto out;
+		}
+		if (n != sizeof(frame))
+			goto invalid;
+		total = le32_to_cpu(frame.total);
+		offset = le32_to_cpu(frame.offset);
+		sequence = le32_to_cpu(frame.sequence);
+		addr_len = le32_to_cpu(frame.addr_len);
+		memcpy(&family, frame.addr, sizeof(family));
+		if (total > 65535 || offset > total ||
+		    !((le16_to_cpu(family) == AF_INET && addr_len == 16) ||
+		      (le16_to_cpu(family) == AF_INET6 && addr_len == 28)))
+			goto invalid;
+		if (!offset) {
+			if (tsk->host_rx_capacity < max_t(u32, total, 1)) {
+				u8 *data = kvmalloc(max_t(u32, total, 1), GFP_KERNEL);
+
+				if (!data) {
+					err = -ENOMEM;
+					goto out;
+				}
+				kvfree(tsk->host_rx_data);
+				tsk->host_rx_data = data;
+				tsk->host_rx_capacity = max_t(u32, total, 1);
+			}
+			tsk->host_rx_sequence = sequence;
+			tsk->host_rx_total = total;
+			tsk->host_rx_received = 0;
+			tsk->host_rx_addr_len = addr_len;
+			memcpy(tsk->host_rx_addr, frame.addr, addr_len);
+			tsk->host_rx_active = true;
+		}
+		if (!tsk->host_rx_active ||
+		    sequence != tsk->host_rx_sequence ||
+		    total != tsk->host_rx_total ||
+		    offset != tsk->host_rx_received ||
+		    addr_len != tsk->host_rx_addr_len ||
+		    memcmp(tsk->host_rx_addr, frame.addr, addr_len))
+			goto invalid;
+
+		memset(&wire_msg, 0, sizeof(wire_msg));
+		vec[0].iov_base = &received;
+		vec[0].iov_len = sizeof(received);
+		vec[1].iov_base = tsk->host_rx_data + offset;
+		vec[1].iov_len = total - offset;
+		n = kernel_recvmsg(tsk->vsocket, &wire_msg, vec, 2,
+				   sizeof(received) + total - offset, MSG_DONTWAIT);
+		if (n < 0) {
+			err = n;
+			goto out;
+		}
+		if (n < sizeof(received) || wire_msg.msg_flags & MSG_TRUNC ||
+		    memcmp(&frame, &received, sizeof(frame)) ||
+		    (n == sizeof(received) && total)) {
+			tsk->host_rx_active = false;
+			err = -EPROTO;
+			goto out;
+		}
+		tsk->host_rx_received += n - sizeof(received);
+		if (tsk->host_rx_received == total)
+			WRITE_ONCE(tsk->host_rx_ready, true);
+	}
+
+	copied = min_t(size_t, len, tsk->host_rx_total);
+	err = copied;
+	if (copied && copy_to_iter(tsk->host_rx_data, copied, &msg->msg_iter) != copied)
+		err = -EFAULT;
+	if (msg->msg_name) {
+		memcpy(msg->msg_name, tsk->host_rx_addr, tsk->host_rx_addr_len);
+		msg->msg_namelen = tsk->host_rx_addr_len;
+	}
+	if (copied < tsk->host_rx_total)
+		msg->msg_flags |= MSG_TRUNC;
+	if (err >= 0 && flags & MSG_TRUNC)
+		err = tsk->host_rx_total;
+	if (!(flags & MSG_PEEK)) {
+		WRITE_ONCE(tsk->host_rx_ready, false);
+		tsk->host_rx_active = false;
+	}
+	goto out;
+
+invalid:
+	/* Discard the offending frame, resetting a partial assembly. In
+	 * particular a missing fragment must never concatenate two senders.
+	 */
+	memset(&wire_msg, 0, sizeof(wire_msg));
+	vec[0].iov_base = &frame;
+	vec[0].iov_len = sizeof(frame);
+	kernel_recvmsg(tsk->vsocket, &wire_msg, vec, 1, sizeof(frame), MSG_DONTWAIT);
+	tsk->host_rx_active = false;
+	err = -EPROTO;
+out:
+	mutex_unlock(&tsk->host_rx_lock);
+	return err;
+}
