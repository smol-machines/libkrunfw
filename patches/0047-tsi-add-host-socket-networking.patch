+/* The outer socket lock serializes each address/data/ack transaction. */
+static int tsi_host_dgram_sendmsg(struct tsi_sock *tsk, struct msghdr *msg,
+				  size_t len)
+{
+	struct tsi_host_send_req req = { 0 };
+	struct tsi_host_send_rsp rsp;
+	struct sockaddr_vm destination = {
+		.svm_family = AF_VSOCK,
+		.svm_cid = VMADDR_CID_HOST,
+		.svm_port = TSI_SENDTO_DATA,
+	};
+	struct msghdr wire = *msg;
+	struct sockaddr *addr = msg->msg_name;
+	int addr_len = msg->msg_namelen;
+	int err;
+	u64 sequence;
+
+	if (len > (tsk->family == AF_INET ? 65507 : 65527))
+		return -EMSGSIZE;
+	if (!addr) {
+		addr = tsk->sendto_addr;
+		addr_len = tsk->sendto_addr_len;
+		if (!addr)
+			return -EDESTADDRREQ;
+	}
+	if (addr->sa_family != tsk->family || tsi_check_addr_len(tsk, addr_len))
+		return -EINVAL;
+	err = tsi_host_autobind(tsk);
+	if (err)
+		return err;
+	if (!tsk->host_send_socket) {
+		struct socket *reply_socket;
+
+		err = tsi_create_control_socket(&reply_socket);
+		if (err)
+			return err;
+		tsk->host_send_socket = reply_socket;
+	}
+	/*
+	 * A separate reply socket keeps an interrupted send's late result out
+	 * of subsequent bind/connect/getname replies. Sequence discards a late
+	 * send result when a later send uses this same reply socket.
+	 */
+	sequence = ++tsk->host_send_sequence;
+	req.svm_port = cpu_to_le32(tsk->svm_port);
+	req.addr_len = cpu_to_le32(addr_len);
+	req.sequence = cpu_to_le64(sequence);
+	memcpy(req.addr, addr, addr_len);
+	err = tsi_control_sendmsg(tsk->host_send_socket, TSI_HOST_SENDTO_ADDR,
+				  &req, sizeof(req));
+	if (err < 0)
+		return err;
+	wire.msg_name = &destination;
+	wire.msg_namelen = sizeof(destination);
+	err = tsk->vsocket->ops->sendmsg(tsk->vsocket, &wire, len);
+	msg->msg_iter = wire.msg_iter;
+	if (err < 0)
+		return err;
+	do {
+		err = tsi_control_recvmsg(tsk->host_send_socket,
+					  TSI_HOST_SENDTO_ADDR, &rsp,
+					  sizeof(rsp));
+		if (err < 0)
+			return err;
+		if (err != sizeof(rsp))
+			return -EPROTO;
+	} while (le64_to_cpu(rsp.sequence) != sequence);
+	err = (s32)le32_to_cpu(rsp.result);
+	if (err >= 0 && err != len)
+		return -EPROTO;
+	return err;
+}
