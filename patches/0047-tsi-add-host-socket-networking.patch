+/* Called with the outer socket locked; reserve the real host port first. */
+static int tsi_host_bind(struct tsi_sock *tsk, struct sockaddr *addr, int addr_len)
+{
+	struct tsi_host_bind_req req = { 0 };
+	struct tsi_getname_rsp rsp = { 0 };
+	struct sock *isk = tsk->isocket->sk;
+	struct sockaddr *bound;
+	int err;
+
+	if (tsk->bound_addr)
+		return -EINVAL;
+	if (addr->sa_family != tsk->family || tsi_check_addr_len(tsk, addr_len))
+		return -EINVAL;
+	addr_len = tsk->family == AF_INET ? sizeof(struct sockaddr_in) :
+					 sizeof(struct sockaddr_in6);
+	bound = kmalloc(addr_len, GFP_KERNEL);
+	if (!bound)
+		return -ENOMEM;
+	if (!tsk->svm_port) {
+		err = tsi_create_proxy(tsk, tsk->vsocket->type);
+		if (err)
+			goto fail;
+	}
+	req.svm_port = cpu_to_le32(tsk->svm_port);
+	req.addr_len = cpu_to_le32(addr_len);
+	req.options = cpu_to_le32((isk->sk_reuse ? 1 : 0) |
+				 (isk->sk_reuseport ? 2 : 0) |
+				 (ipv6_only_sock(isk) ? 4 : 0) |
+				 (sock_flag(isk, SOCK_BROADCAST) ? 8 : 0));
+	memcpy(req.addr, addr, addr_len);
+	err = tsi_control_sendmsg(tsk->csocket, TSI_BIND, &req, sizeof(req));
+	if (err < 0)
+		goto fail;
+	err = tsi_control_recvmsg(tsk->csocket, TSI_BIND, &rsp, sizeof(rsp));
+	if (err < 0)
+		goto fail;
+	if (err < sizeof(rsp)) {
+		err = -EPROTO;
+		goto fail;
+	}
+	if (rsp.result) {
+		err = rsp.result;
+		goto fail;
+	}
+	if (rsp.addr_len != addr_len ||
+	    ((struct sockaddr *)rsp.addr)->sa_family != tsk->family) {
+		err = -EPROTO;
+		goto fail;
+	}
+	memcpy(bound, rsp.addr, addr_len);
+	tsk->bound_addr = bound;
+	tsk->bound_addr_len = addr_len;
+	return 0;
+fail:
+	kfree(bound);
+	return err;
+}
+
+static int tsi_host_autobind(struct tsi_sock *tsk)
+{
+	struct sockaddr_storage addr = { 0 };
+
+	if (tsk->bound_addr)
+		return 0;
+	addr.ss_family = tsk->family;
+	return tsi_host_bind(tsk, (struct sockaddr *)&addr,
+			     tsk->family == AF_INET ? sizeof(struct sockaddr_in) :
+						      sizeof(struct sockaddr_in6));
+}
